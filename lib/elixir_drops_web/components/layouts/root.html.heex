<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.seo_meta_tags attributes={assigns[:seo_attributes]} />
    <.live_title>
      {assigns[:page_title] || "ElixirDrops"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="icon" href={~p"/images/logo.png"} type="image/png" />
    <link
      :if={assigns[:drop] && assigns[:drop].short_id}
      rel="alternate"
      type="text/markdown"
      href={url(~p"/d/#{assigns[:drop].short_id}") <> ".md"}
    />
    <link rel="index" type="text/markdown" href={url(~p"/index.md")} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script
      defer
      data-domain={ElixirDropsWeb.Endpoint.host()}
      src="https://plausible.io/js/script.js"
    >
    </script>
  </head>
  <body class="font-roboto text-[#4f4f4f] bg-white">
    {@inner_content}
  </body>
</html>
