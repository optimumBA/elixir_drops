<section class="h-[100vh] flex flex-col items-center justify-center gap-y-6 bg-gradient-to-r from-[#4c3ddb] via-[#6159be] to-[#818494] py-4">
  <div class="seo-image">
    <div class="seo-image__toolbar rounded-t-2xl bg-[#252525] flex justify-start items-center gap-x-3 py-5 px-8 mb-0">
      <div class="rounded-full bg-[#fb5e55] h-3 w-3"></div>
      <div class="rounded-full bg-[#ffde32] h-3 w-3"></div>
      <div class="rounded-full bg-[#24c942] h-3 w-3"></div>
    </div>
    <%= ElixirDropsWeb.DropComponents.to_html(@code_block) %>
  </div>

  <div class="bg-white/70 px-2 py-2 rounded-xl opacity-75">
    <ElixirDropsWeb.Icons.elixir_drops_logo class="h-10" />
  </div>
</section>
