<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · ElixirDrops</title>
    <link rel="stylesheet" href="/assets/css/app.css" />
    <link rel="icon" href="/images/logo.png" type="image/png" />
  </head>
  <body class="font-roboto text-[#4f4f4f] bg-white">
    <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center px-4 py-12">
      <a href="/" aria-label="ElixirDrops home">
        <img src="/images/logo.png" alt="ElixirDrops" class="mb-8 h-12 w-auto" />
      </a>
      <p class="text-sm text-[#6b6b6b]">Error 404</p>
      <h1 class="mb-3 text-2xl text-[#252525] md:text-4xl">Page not found</h1>
      <p class="mb-8 text-base">
        We could not find the page you asked for. It may have moved, or the address may be mistyped.
      </p>
      <ul class="flex flex-col gap-3 sm:flex-row">
        <li>
          <a
            href="/"
            class="flex min-h-11 items-center justify-center rounded-lg bg-blue_primary px-6 py-2 text-sm font-semibold text-[#eae8fd] hover:opacity-80"
          >
            Go to the latest Drops
          </a>
        </li>
        <li>
          <a
            href="/archive"
            class="flex min-h-11 items-center justify-center rounded-lg border-2 border-blue_primary px-6 py-2 text-sm font-semibold text-blue_primary hover:bg-[#eae8fd]"
          >
            Browse the archive
          </a>
        </li>
      </ul>
    </main>
  </body>
</html>
