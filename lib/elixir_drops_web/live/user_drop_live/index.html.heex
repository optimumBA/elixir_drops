<Layouts.app flash={@flash}>
  <section class="drops-container relative h-full w-full">
    <DropComponents.notification_component
      end_of_notifications_timeline?={@end_of_notifications_timeline?}
      notifications={@streams.notifications}
      notification_count={@notification_count}
    />

    <section id="main-page-body">
      <DropComponents.navbar
        current_url={~p"/profile"}
        current_user={@current_user}
        live_action={@live_action}
        notification_count={@notification_count}
        search_query={@navbar_search_query}
        show_suggestions?={@show_suggestions?}
      />
      <section :if={@live_action in [:edit, :new]}>
        <.live_component
          current_user={@current_user}
          drop={@drop}
          id="drops-form"
          live_action={@live_action}
          module={FormComponent}
        />
      </section>
      <section
        :if={@live_action in [:index, :show_bookmarks]}
        class="text-[#252525] relative user-drops"
      >
        <DropComponents.user_drops_header
          bookmark_tab?={@bookmark_tab?}
          current_user={@current_user}
          profile_search_suggestions={@search_suggestions}
          search_query={@search_query}
          search_suggestions={@search_suggestions}
          show_profile_suggestions?={@show_profile_suggestions?}
        />

        <DropsListHelper.drops_list
          :if={!@bookmark_tab?}
          batch_size={@batch_size}
          current_user={@current_user}
          drops={@streams.drops}
          drops_empty?={@drops_empty?}
          end_of_timeline?={@end_of_timeline?}
          id="user-drops"
          loading_more={@loading_more}
          page={@page}
          search_query={@search_query}
          searching={@searching}
        />

        <div :if={@bookmark_tab?}>
          {live_render(@socket, Bookmarks,
            session: %{
              "bookmark_search_query" => @bookmark_search_query,
              "user_id" => @current_user.id
            },
            id: "bookmarks_liveview"
          )}
        </div>
        <DropComponents.create_drop_button_mobile
          current_user={@current_user}
          class="user-drops-mobile-btn"
        />
      </section>
      <DropComponents.cancel_form_popup_message current_user={@current_user} />
      <DropComponents.copied_link_popup_message />
    </section>
  </section>
  <!-- Mobile Search Overlay -->
  <DropComponents.search_overlay_mobile
    current_user={@current_user}
    search_query={@search_query}
    search_suggestions={@search_suggestions}
    show_suggestions?={@show_profile_suggestions?}
  />
</Layouts.app>
