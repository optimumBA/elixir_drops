<Layouts.app flash={@flash}>
  <section class="drops-container relative h-full w-full">
    <DropComponents.notification_component
      end_of_notifications_timeline?={@end_of_notifications_timeline?}
      notifications={@streams.notifications}
      notification_count={@notification_count}
    />

    <section id="main-page-body">
      <DropComponents.navbar
        current_url={~p"/u/#{@user.id}"}
        current_user={@current_user}
        live_action={@live_action}
        notification_count={@notification_count}
        search_query={@navbar_search_query}
        search_suggestions={@search_suggestions}
        show_suggestions?={@show_suggestions?}
        show_user_drops?={false}
      />

      <section class="text-[#252525] relative">
        <div
          class="full-width"
          id="public-profile"
          phx-mounted={JS.remove_class("shadow-md shadow-[#c4c0c8]", to: ".header")}
        >
          <div class="text-[#EAE8FD] bg-gradient-to-r from-[#4b37f0] via-[#5444f1] to-[#5f4ef2] py-6 md:pl-6">
            <div class="flex flex-col md:flex-row items-center gap-x-4 gap-y-2 breakout md:pl-6">
              <img
                src={@user.avatar}
                alt={"GitHub avatar of #{@user.github_username}"}
                class="w-16 h-16 rounded-full object-fill"
              />
              <div class="text-center md:text-left">
                <h1 class="text-xl">{@user.name}</h1>
                <p class="text-base">{@user.github_username}</p>
                <a
                  href={"https://github.com/#{@user.github_username}"}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm underline"
                >
                  View on GitHub
                </a>
              </div>
              <ul class="flex items-center gap-x-6 md:ml-auto md:pr-12 text-base">
                <li id="profile-drops-total">
                  {@drops_total} {total_label(@drops_total, "Drop")}
                </li>
                <li id="profile-comments-total">
                  {@comments_total} {total_label(@comments_total, "Comment")}
                </li>
              </ul>
            </div>
          </div>

          <nav
            class="md:pl-20 bg-[#f6f6f6] shadow-md shadow-[#cfcdd2] nav-secondary"
            aria-label="Profile sections"
          >
            <div class="flex items-center px-4 md:px-0">
              <ul class="flex items-center" id="profile-tabs">
                <li class={tab_class(@tab == :drops)}>
                  <.link
                    patch={~p"/u/#{@user.id}/drops"}
                    aria-current={@tab == :drops && "page"}
                    id="profile-drops-tab"
                  >
                    Drops
                  </.link>
                </li>
                <li class={tab_class(@tab == :comments)}>
                  <.link
                    patch={~p"/u/#{@user.id}/comments"}
                    aria-current={@tab == :comments && "page"}
                    id="profile-comments-tab"
                  >
                    Comments
                  </.link>
                </li>
                <li :if={@tab == :drops} class="min-h-full py-4 flex items-center">
                  <form
                    id="profile-drops-search"
                    phx-submit="profile_search_submit"
                    role="search"
                    class="relative flex items-center"
                  >
                    <.icon
                      name="hero-magnifying-glass"
                      class="absolute left-3 h-4 w-4 text-gray-500"
                    />
                    <label for="profile-drops-search-query" class="sr-only">
                      Search {@user.github_username}'s Drops
                    </label>
                    <input
                      id="profile-drops-search-query"
                      type="text"
                      name="query"
                      value={@search_query}
                      placeholder="Search Drops"
                      class={[
                        "pl-10 pr-4 py-2 bg-transparent border-0",
                        "focus:outline-none focus:ring-0 placeholder-gray-500 text-sm",
                        "min-w-[200px]"
                      ]}
                    />
                  </form>
                </li>
              </ul>
            </div>
          </nav>
        </div>

        <div
          id="profile-drops-feed"
          hidden={@tab != :drops}
          phx-hook="ProfileFeed"
          data-feed-tab="drops"
          data-profile-user-id={@user.id}
        >
          <DropsListHelper.drops_list
            batch_size={@batch_size}
            current_user={@current_user}
            drops={@streams.drops}
            drops_empty?={@drops_empty?}
            end_of_timeline?={@end_of_timeline? or @batch_status == :failed}
            feed_state={feed_state(assigns)}
            id="profile-drops"
            loading_more={@loading_more}
            page={@page}
            search_query={@search_query}
            searching={@searching}
            show_user_drops?={false}
          />
          <p
            :if={@drops_empty? and not @searching}
            id="profile-drops-empty"
            class="text-[#656565] text-lg text-center py-8"
          >
            No Drops to show yet.
          </p>
          <div
            :if={@batch_status == :failed}
            id="profile-drops-retry"
            role="alert"
            class="flex flex-col items-center gap-y-2 py-6 text-[#4f4f4f]"
          >
            <p>We could not load more Drops.</p>
            <button
              type="button"
              phx-click="retry_load_more"
              class="text-[#eae8fd] text-sm bg-blue_primary hover:opacity-80 px-4 py-2 rounded-lg"
            >
              Retry
            </button>
          </div>
        </div>

        <div
          id="profile-comments"
          hidden={@tab != :comments}
          class="px-6 md:px-8 lg:px-12 py-12"
          phx-hook="ProfileFeed"
          data-feed-tab="comments"
          data-profile-user-id={@user.id}
        >
          {raw(comment_expand_script())}
          <div class="max-w-3xl mx-auto" data-feed-state={comments_feed_state(assigns)}>
            <div id="profile-comments-list" phx-update="stream" class="flex flex-col">
              <div
                :for={{dom_id, comment} <- @streams.comment_activity}
                id={dom_id}
                data-feed-entry
                class="border-b border-gray-200 py-4"
              >
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                  <.link
                    navigate={~p"/d/#{comment.drop.short_id}"}
                    class="font-medium text-[#2F19EE] hover:opacity-80"
                  >
                    {comment.drop.title}
                  </.link>
                  <span class="text-[#6b6b6b]">{comment_date(comment.inserted_at)}</span>
                </div>
                <p :if={comment.parent_id} class="text-sm text-[#6b6b6b] mt-1">
                  Replying to
                  <DropComponents.contributor_link user={comment.parent.user} class="font-medium">
                    {comment.parent.user && comment.parent.user.name}
                  </DropComponents.contributor_link>
                  <span class="italic">{maybe_parent_excerpt(comment.parent.body)}</span>
                </p>
                <div
                  id={"profile-comment-body-#{comment.id}"}
                  class={[
                    "prose my-2 break-words text-[#575757] prose-pre:overflow-x-auto",
                    long_comment?(comment.body) && "max-h-48 overflow-hidden"
                  ]}
                >
                  {DropComponents.to_html(comment.body)}
                </div>
                <button
                  :if={long_comment?(comment.body)}
                  type="button"
                  id={"profile-comment-toggle-#{comment.id}"}
                  data-profile-expand
                  aria-expanded="false"
                  aria-controls={"profile-comment-body-#{comment.id}"}
                  class="text-sm text-[#2F19EE] hover:opacity-80 mr-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5947F1]"
                >
                  <span data-comment-more>Show more</span>
                  <span data-comment-less class="hidden">Show less</span>
                </button>
                <.link
                  navigate={discussion_path(comment)}
                  class="text-sm text-[#6b6b6b] hover:text-[#5947F1]"
                >
                  View in discussion
                </.link>
              </div>
            </div>

            <p
              :if={@comments_loaded? and @comments_empty?}
              id="profile-comments-empty"
              class="text-[#656565] text-lg text-center py-8"
            >
              No comments to show yet.
            </p>

            <div
              :if={@comments_status == :loading or not @comments_loaded?}
              class="flex items-center justify-center gap-x-2 py-6 text-[#656565]"
            >
              <div class="w-4 h-4 border-2 border-gray-300 border-t-[#5947F1] rounded-full animate-spin">
              </div>
              <span>Loading {@comments_batch_size} more...</span>
            </div>

            <div
              :if={@comments_status == :failed}
              id="profile-comments-retry"
              role="alert"
              class="flex flex-col items-center gap-y-2 py-6 text-[#4f4f4f]"
            >
              <p>We could not load more comments.</p>
              <button
                type="button"
                phx-click="retry_load_more"
                class="text-[#eae8fd] text-sm bg-blue_primary hover:opacity-80 px-4 py-2 rounded-lg"
              >
                Retry
              </button>
            </div>

            <div
              data-end-of-timeline={if @comments_end?, do: "true", else: "false"}
              id="profile-comments-scroll-marker"
              phx-hook="InfiniteScroll"
              class="h-3 w-full"
            >
            </div>
          </div>
        </div>
      </section>

      <DropComponents.copied_link_popup_message />
    </section>
  </section>

  <DropComponents.signin_popup_message />
  <!-- Mobile Search Overlay -->
  <DropComponents.search_overlay_mobile
    current_user={@current_user}
    search_query={@navbar_search_query}
    search_suggestions={@search_suggestions}
    show_suggestions?={@show_suggestions?}
  />
</Layouts.app>
