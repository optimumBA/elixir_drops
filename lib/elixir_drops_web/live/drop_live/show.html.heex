<section class="drops-container relative h-full w-full">
  <DropComponents.navbar
    current_user={@current_user}
    live_action={@live_action}
    show_user_drops?={@show_user_drops?}
  />

  <section class="pt-10 py-4">
    <DropComponents.drop
      avatar={@drop.user.avatar}
      body={@drop.body}
      created_at={@drop.inserted_at}
      github_username={@drop.user.github_username}
      id={@drop.id}
      timezone_offset={@timezone_offset}
      title={@drop.title}
      unique_url_string={@drop.unique_url_string}
    />
  </section>
</section>

<DropComponents.signin_popup_message />
