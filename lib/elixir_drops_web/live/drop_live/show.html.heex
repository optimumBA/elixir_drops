<section class="drops-container relative h-full w-full">
  <DropComponents.navbar
    current_user={@current_user}
    live_action={@live_action}
    show_user_drops?={@show_user_drops?}
    search_query={@navbar_search_query}
    show_suggestions={@show_suggestions}
    search_suggestions={@search_suggestions}
  />

  <section class="pt-10 py-4">
    <DropComponents.drop comment_count={@comment_count} current_user={@current_user} drop={@drop} />
  </section>

  <%= if @drop do %>
    <section class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <CommentComponents.comment_section
        comment_count={@comment_count || @drop.comment_count || 0}
        comment_offset={@comment_offset}
        comment_form={@comment_form}
        reply_form={@reply_form}
        current_user={@current_user}
        current_url={~p"/d/#{@drop.short_id}"}
        delete_comment_id={@delete_comment_id}
        comments={@streams.comments}
        top_level_comment_count={@top_level_comment_count}
      />
      <button
        :if={@new_comments?}
        class={[
          "text-white text-sm flex items-center justify-center gap-x-1 bg-[#9666d9] hover:opacity-80 rounded-xl",
          "px-4 py-2",
          "absolute top-0 left-1/2 -translate-x-1/2 z-50 shadow-lg"
        ]}
        id="new-comments-indicator"
        phx-click={JS.push("stream_new_comments")}
      >
        <span><.icon name="hero-arrow-down" class="h-4 w-4" /></span>
        <span>New Comments</span>
      </button>
    </section>
  <% end %>

  <DropComponents.copied_link_popup_message />
</section>

<DropComponents.signin_popup_message />
<!-- Mobile Search Overlay -->
<DropComponents.search_overlay_mobile
  search_query={@navbar_search_query}
  show_suggestions={@show_suggestions}
  search_suggestions={@search_suggestions}
  current_user={@current_user}
/>

<script type="application/ld+json">
  <%= raw(StructuredData.generate_drop_json_ld(@drop)) %>
</script>
