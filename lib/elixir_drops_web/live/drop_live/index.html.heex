<section class="relative h-full w-full" id="drops-container" phx-hook="DropsContainer">
  <DropComponents.navbar current_user={@current_user} live_action={@live_action} />

  <section class="text-[#252525] relative">
    <DropComponents.welcome_message condition={@show_welcome_message? && !@current_user} />

    <DropsListHelper.drops_list
      drops={@streams.drops}
      end_of_timeline?={@end_of_timeline?}
      id="drops"
      show_user_drops?={false}
      timezone_offset={@timezone_offset}
    />

    <button
      :if={@new_drops?}
      class={[
        "text-white text-sm flex items-center justify-center gap-x-1 bg-[#9666d9] hover:opacity-80 rounded-xl mx-auto",
        " mt-2 w-[30%] sm:w-[20%] md:w-[15%] px-1 py-1",
        "fixed left-[50%] translate-x-[-50%] z-[1000000]"
      ]}
      id="new-drops-indicator"
      phx-click={JS.push("refresh-drops") |> JS.dispatch("scroll-to-top", to: "#drops-container")}
    >
      <span><.icon name="hero-arrow-up" class="h-4 w-4" /></span>
      <span>New Drops</span>
    </button>
  </section>

  <DropComponents.copied_link_popup_message />

  <DropComponents.create_post_button_mobile current_user={@current_user} />
</section>

<DropComponents.cancel_form_popup_message current_user={@current_user} />
<DropComponents.signin_popup_message />
